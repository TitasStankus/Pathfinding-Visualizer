<Window x:Class="Pathfinding_Visualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pathfinding_Visualizer"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="1080"
        Width="1920">

    <Grid>

        <!-- Two rows:
         Row 0 = controls/statistics
         Row 1 = pathfinding grid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Two columns:
         Column 0 = statistics
         Column 1 = controls -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- STATISTICS -->
        <Border
        Grid.Row="0"
        Grid.Column="0"
        Margin="10"
        BorderBrush="Gray"
        BorderThickness="1"
        Padding="10">

            <StackPanel>

                <TextBlock
                Text="Statistics"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,0,0,15"/>

                <TextBlock Text="Algorithm"/>

                <TextBlock
                x:Name="AlgorithmText"
                FontWeight="Bold"
                Margin="0,0,0,10"/>

                <TextBlock Text="Nodes Visited"/>

                <TextBlock
                x:Name="NodesVisitedText"
                FontWeight="Bold"
                Margin="0,0,0,10"/>

                <TextBlock Text="Path Length"/>

                <TextBlock
                x:Name="PathLengthText"
                FontWeight="Bold"
                Margin="0,0,0,10"/>

                <TextBlock Text="Runtime"/>

                <TextBlock
                x:Name="RuntimeText"
                FontWeight="Bold"/>

            </StackPanel>

        </Border>


        <!-- CONTROLS -->
        <Grid
        Grid.Row="0"
        Grid.Column="1"
        Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>


            <!-- CONTROL ROW 1 -->
            <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

                <TextBox
                x:Name="GridSizeInput"
                Width="140"
                Height="60"
                Text="20"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
                FontSize="16"/>

                <Button
                Content="Create/Reset Grid"
                Click="GenerateGrid_Click"
                Margin="10,0,0,0"
                Padding="20,10"/>

                <Button
                Content="Reset Path"
                Click="ResetPath_Click"
                Margin="10,0,0,0"
                Padding="20,10"/>

                <TextBlock
                Text="Algorithm:"
                VerticalAlignment="Center"
                Margin="40,0,10,0"
                FontSize="16"/>

                <ComboBox
                x:Name="AlgorithmComboBox"
                Width="300"
                Height="60"
                SelectedIndex="0"
                FontSize="16"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Breadth-First Search"/>
                    <ComboBoxItem Content="Depth-First Search"/>
                    <ComboBoxItem Content="Dijkstra"/>
                    <ComboBoxItem Content="A*"/>

                </ComboBox>

                <Button
                Content="Run"
                Click="RunAlgorithm_Click"
                Margin="10,0,0,0"
                Padding="20,10"/>

                <Button
                Content="Pause"
                Click="Pause_Click"
                Margin="5,0,0,0"
                Padding="20,10"/>

                <Button
                Content="Resume"
                Click="Resume_Click"
                Margin="5,0,0,0"
                Padding="20,10"/>

                <Button
                Content="Stop"
                Click="Stop_Click"
                Margin="5,0,0,0"
                Padding="20,10"/>

            </StackPanel>


            <!-- CONTROL ROW 2 -->
            <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,10,0,0"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

                <TextBlock
                Text="Animation Speed:"
                VerticalAlignment="Center"
                Margin="0,0,5,0"
                FontSize="16"/>

                <Slider
                x:Name="AnimationSpeedSlider"
                Minimum="1"
                Maximum="100"
                Value="20"
                Width="200"
                Height="32"
                VerticalAlignment="Bottom"
                ValueChanged="AnimationSpeedSlider_ValueChanged"/>

                <TextBlock
                Text="Maze:"
                VerticalAlignment="Center"
                Margin="25,0,5,0"
                FontSize="16"/>

                <ComboBox
                x:Name="MazeComboBox"
                Width="200"
                Height="50"
                SelectedIndex="0"
                FontSize="16"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Random Walls"/>
                    <ComboBoxItem Content="Recursive Backtracking"/>
                    <ComboBoxItem Content="Prim's Algorithm"/>

                </ComboBox>

                <Button
                Content="Generate Maze"
                Click="GenerateMaze_Click"
                Margin="10,0,0,0"
                Padding="20,10"/>

            </StackPanel>

        </Grid>


        <!-- PATHFINDING GRID -->
        <UniformGrid
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        x:Name="GridContainer"
        Margin="10"/>

    </Grid>

</Window>