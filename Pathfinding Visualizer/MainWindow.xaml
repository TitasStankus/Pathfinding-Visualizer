<Window x:Class="Pathfinding_Visualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pathfinding_Visualizer"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="900">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal"
                Margin="10">

            <TextBox
                x:Name="GridSizeInput"
                Width="100"
                Text="20"/>

            <Button
                Content="Create/Reset Grid"
                Click="GenerateGrid_Click"
                Margin="10,0,0,0"/>

            <Button
                Content="Reset Path"
                Click="ResetPath_Click"
                Margin="10,0,0,0"/>

            <TextBlock
                Text="Algorithm:"
                VerticalAlignment="Center"
                Margin="20,0,5,0"/>

            <ComboBox
                x:Name="AlgorithmComboBox"
                Width="150"
                SelectedIndex="0">

                <ComboBoxItem Content="Breadth-First Search"/>
                <ComboBoxItem Content="Depth-First Search"/>
                <ComboBoxItem Content="Dijkstra"/>
                <ComboBoxItem Content="A*"/>
            </ComboBox>

            <Button
                Content="Run"
                Click="RunAlgorithm_Click"/>

            <Button
                Content="Pause"
                Click="Pause_Click"/>

            <Button
                Content="Resume"
                Click="Resume_Click"/>

            <Button
                Content="Stop"
                Click="Stop_Click"/>

            <TextBlock
                Text="Animation Speed:"
                VerticalAlignment="Center"
                Margin="20,0,5,0"/>

            <Slider
                x:Name="AnimationSpeedSlider"
                Minimum="1"
                Maximum="100"
                Value="20"
                Width="150"
                ValueChanged="AnimationSpeedSlider_ValueChanged"/>

            <TextBlock
                x:Name="TimeLabel"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Text="0 ms"/>
            
            <TextBlock
                Text="Maze:"
                VerticalAlignment="Center"
                Margin="20,0,5,0"/>

            <ComboBox
                x:Name="MazeComboBox"
                Width="150"
                SelectedIndex="0">
                
                <ComboBoxItem Content="Random Walls"/>
            </ComboBox>
            
            <Button
                Content="Generate Maze"
                Click="GenerateMaze_Click"/>

        </StackPanel>


        <UniformGrid
        Grid.Row="1"
        x:Name="GridContainer"
        Margin="10"/>

    </Grid>
</Window>
