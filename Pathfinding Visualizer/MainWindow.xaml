<Window x:Class="Pathfinding_Visualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pathfinding_Visualizer"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="900">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal"
                Margin="10">

            <TextBox
                x:Name="GridSizeInput"
                Width="100"
                Text="20"/>

            <Button
                Content="Create Grid"
                Click="GenerateGrid_Click"
                Margin="10,0,0,0"/>

            <Button
                Content="Reset Path"
                Click="ResetPath_Click"
                Margin="10,0,0,0"/>

            <Button
                Content="Run BFS"
                Click="RunBFS_Click"
                Margin="10,0,0,0"/>

            <Button
                Content="Run DFS"
                Click="RunDFS_Click"
                Margin="10,0,0,0"/>

            <Button
                Content="Run Dijkstra"
                Click="RunDijkstra_Click"
                Margin="10,0,0,0"/>

            <Button
                Content="Run A*"
                Click="RunAStar_Click"
                Margin="10,0,0,0"/>

            <TextBlock
                Text="Animation Speed:"
                VerticalAlignment="Center"
                Margin="20,0,5,0"/>

            <Slider
                x:Name="AnimationSpeedSlider"
                Minimum="1"
                Maximum="100"
                Value="20"
                Width="150"
                ValueChanged="AnimationSpeedSlider_ValueChanged"/>

            <Button
                Content="Pause"
                Click="Pause_Click"/>

            <Button
                Content="Resume"
                Click="Resume_Click"/>
            
            <Button
                Content="Stop"
                Click="Stop_Click"/>

        </StackPanel>


        <UniformGrid
        Grid.Row="1"
        x:Name="GridContainer"
        Margin="10"/>

    </Grid>
</Window>
